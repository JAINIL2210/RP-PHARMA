# RP PHARMA - Environment Configuration Example
# Copy this file to .env and configure as needed

# Flask App Secret Key
SECRET_KEY=rp-pharma-super-secret-key-change-in-production-2026

# Database URI
# Default: SQLite (no setup needed)
DATABASE_URI=sqlite:///rp_pharma.db

# For MySQL Database (uncomment and replace credentials):
# DATABASE_URI=mysql+pymysql://rp_user:rp_password@localhost:3306/rp_pharma_db

# Admin User Defaults
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@rppharma.com
ADMIN_PASSWORD=Admin@RP2026

# Uploads Configuration
MAX_CONTENT_LENGTH=10485760  # 10MB
UPLOAD_FOLDER=app/static/uploads
